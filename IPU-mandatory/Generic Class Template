#include<iostream>
#include<string>
using namespace std;
template <typename T>
class Compare{
	T a,b;
	public:
		Compare(T i, T j): a(i),b(j){
		}
		~Compare(){
			cout<<"Desctructor Called"<<endl;
		}
		T bigger() {
		return(a>b?a:b);
		}
		
};
int main(){
	Compare<int>c1(2,3);
	Compare<float>c2(12.5,10.6);
	Compare<string>c3("Hello","World");
	cout<<c1.bigger()<<endl;
	cout<<c2.bigger()<<endl;
	cout<<c3.bigger()<<endl;}